# Postgres connection string. Locally: postgres://localhost:5432/brandvault
# In production use the pooled URL from Neon / Supabase (sslmode=require).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brandvault

# Secret used to sign session cookies (min 32 chars). Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# GenAI: Anthropic Claude, called from the backend only (never exposed to the browser).
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-opus-5

# Password for the seeded demo account (demo@brandvault.dev). Used by `npm run db:seed`.
DEMO_PASSWORD=Demo1234!
