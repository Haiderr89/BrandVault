# Postgres connection string. Locally: postgres://localhost:5432/brandvault
# In production use the pooled URL from Neon / Supabase (sslmode=require).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brandvault

# Secret used to sign session cookies (min 32 chars). Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# GenAI (backend only, never exposed to the browser). Set ONE of the two providers.
# Gemini is used when GEMINI_API_KEY is set (free key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Otherwise Anthropic Claude is used.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-opus-5

# Password for the seeded demo account (demo@brandvault.dev). Used by `npm run db:seed`.
DEMO_PASSWORD=Demo1234!

# Optional n8n bonus: events are POSTed here (sent after the response; skipped when unset).
N8N_WEBHOOK_URL=
# Sent as the X-BrandVault-Secret header; configure the same value in n8n's Header Auth credential.
N8N_WEBHOOK_SECRET=
